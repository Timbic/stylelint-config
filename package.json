{
	"name": "@timbic/stylelint-config",
	"type": "module",
	"version": "1.0.0",
	"private": false,
	"description": "Timbic's stylelint configuration",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"stylelint",
		"stylelint-config"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/stylelint-config.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "pnpm dlx stylelint-config-inspector --config stylelint.config.ts",
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"dependencies": {
		"postcss-html": "2.0.0",
		"stylelint-no-unsupported-browser-features": "8.1.1",
		"stylelint-order": "8.1.1"
	},
	"peerDependencies": {
		"stylelint": "^17.0.0"
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.1.0",
		"@timbic/prettier-config": "1.1.4",
		"bumpp": "12.2.2",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"stylelint": "17.14.1",
		"tsdown": "0.22.14",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*/**/*.{js,ts,md,json}": [
			"pnpm fmt",
			"pnpm lint:fix"
		]
	},
	"packageManager": "pnpm@11.22.0"
}
