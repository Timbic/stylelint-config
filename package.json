{
	"name": "@timbic/stylelint-config",
	"type": "module",
	"version": "1.1.0",
	"private": false,
	"description": "Timbic's stylelint configuration",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"stylelint",
		"stylelint-config"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/stylelint-config.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "pnpm dlx stylelint-config-inspector --config stylelint.config.ts",
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"dependencies": {
		"postcss-html": "^2.0.1",
		"stylelint": "^17.16.0",
		"stylelint-no-unsupported-browser-features": "^8.1.2",
		"stylelint-order": "^8.1.3"
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.2.5",
		"@timbic/prettier-config": "2.0.4",
		"bumpp": "12.3.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.1",
		"tsdown": "0.23.7",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,md,json,yaml,yml}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "pnpm@12.21.0"
}
